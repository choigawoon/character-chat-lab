# 모델 서버 연결 — 복사해서 .env 로 쓴다(.env 는 git 에 안 올라간다)

# 1) 로컬 Ollama (기본) — 먼저: ollama pull gemma4:e2b && ollama pull gemma4:e4b
LLM_API=ollama
LLM_BASE_URL=http://localhost:11434

# 2) OpenAI 호환 관문(litellm · vLLM · OpenRouter 등)
# LLM_API=openai
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=sk-...
# REASONING_EFFORT=none     # 생각 모드 끄기(Ollama 는 none). 관문이 모르는 값이면 비운다: REASONING_EFFORT=

# 3) {model, messages} → {text, usage} 관문 — 주소는 엔드포인트 전체
# LLM_API=textgen
# LLM_BASE_URL=https://example.com/api/text/generate
# LLM_HEADERS={"X-Caller":"chat-lab"}
# LLM_USER_HEADER=X-Actor

# 화면의 모델 버튼 — id 는 모델 서버가 아는 이름. 마지막 것이 기본(DEFAULT_MODEL 로 바꿀 수 있다)
# MODELS=[{"key":"e2b","label":"E2B","id":"gemma4:e2b"},{"key":"e4b","label":"E4B","id":"gemma4:e4b"}]
# DEFAULT_MODEL=e4b

# 생성 설정
# TEMPERATURE=0.8
# MAX_TOKENS=600
